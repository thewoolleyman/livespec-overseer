# caam-delivery-push: pushes the role holder's live login (no refresh token) to
# every host in ~/.local/state/caam-usage-rotate/delivery-hosts over ssh (plan
# central-credential-service). Install on the credential-rotation role holder
# from this repo's checkout:
#   just install-caam-delivery-push     idempotent; rewrites ExecStart to this
#                                       checkout's .venv entry point, creates the
#                                       host list and known-hosts record if
#                                       absent, pins listed hosts' keys, starts
#   just uninstall-caam-delivery-push   revert; disables and removes the unit,
#                                       keeps the host list
# Status: <checkout>/.venv/bin/caam-delivery-push status
[Unit]
Description=CAAM credential push to listed hosts (credential-rotation role holder)

[Service]
Type=simple
# Unbuffered, so each push and Remote Control line reaches the journal when it
# happens rather than in hours-late bursts (overseer-olhkq3).
Environment=PYTHONUNBUFFERED=1
ExecStart=caam-delivery-push run
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
