#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

export PATH="$SCRIPT_DIR:$PATH"
export PYTHONPATH="$PLUGIN_ROOT${PYTHONPATH:+:$PYTHONPATH}"

# NOT `python3 -m overseer.start`: `-m` puts the CALLER's current directory at
# sys.path[0], ahead of PYTHONPATH, so running this from inside a
# livespec-overseer checkout imports THAT checkout's overseer package and starts
# the daemon from its version's runtime prefix. Running a file inside the plugin
# puts the plugin's own directory there instead. See overseer/launch.py.
exec python3 "$PLUGIN_ROOT/overseer/launch.py" overseer.start "$@"
