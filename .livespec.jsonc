// Project-local livespec configuration for livespec-overseer.
//
// livespec-overseer is the Control-Plane OPERATOR TOOL: a two-pane tmux
// supervisor (the `overseerd` daemon plus a thin interactive overseer pane)
// that watches every tracked session's context headroom, injects an
// escalating wrap-up at threshold, and atomically restarts a session ONLY
// once that session has declared itself ready on the filesystem.
//
// Repo class: `control-plane-tool` (livespec
// SPECIFICATION/non-functional-requirements.md §"Fleet membership contract",
// ratified v171). It is a PEER of the `console` class, never a component of
// it: `console` ships the cockpit APPLICATION, this ships an operator TOOL.
//
// Unlike `console`, this class IS an ordinary pin-and-bump consumer — its
// ruff / pyright-strict / coverage / Result-railway gates all come from
// livespec-dev-tooling, so a dev-tooling release directly determines whether
// this repo stays green. That is precisely why `console` could not be reused:
// livespec-dev-tooling's `_PIN_WEB_CLASSES` is the subtraction set
// `_ALL_CLASSES - {"console"}`.
{
  // Worktree-discipline pack policy. "required" — the DEFAULT, and what an
  // absent key means — makes `just check` fail when the canonical pack is not
  // installed and imported by the root justfile. "optional" is the sanctioned,
  // reviewable opt-out. Written explicitly at install time so the obligation is
  // readable here rather than inferred from a verifier failure.
  "worktree_discipline": { "pack": "required" },
  // Dispatcher/Fabro implementation commits use the operator identity below.
  // Mechanical authors are limited to the GitHub Apps proven by this repo's
  // release and dependency-pin automation/history.
  "git_author": {
    "operator_name": "Chad Woolley",
    "operator_email": "thewoolleyman@gmail.com",
    "mechanical_authors": [
      { "name": "livespec-pr-bot[bot]", "email": "livespec-pr-bot[bot]@users.noreply.github.com" },
      { "name": "livespec-pr-bot[bot]", "email": "283469463+livespec-pr-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "thewoolleyman-factory-bot[bot]@users.noreply.github.com" },
      { "name": "thewoolleyman-factory-bot[bot]", "email": "283469463+thewoolleyman-factory-bot[bot]@users.noreply.github.com" }
    ]
  },
  // Cross-repository citations the spec may make (doctor-no-cross-spec-reference).
  // constraints.md §"Factory routing" cites livespec-dev-tooling's
  // §"Fabro factory registry", and non-functional-requirements.md
  // §"Constraints" cites livespec-dev-tooling's §"Delegated pre-push gate" and
  // livespec's §"Enforcement-suite invocation" (its Delegated gate execution
  // clause). Each entry is the BARE heading form: a file-qualified entry is
  // validated against a local sibling clone that CI runners do not have.
  "external_references": {
    "livespec-dev-tooling": ["§\"Fabro factory registry\"", "§\"Delegated pre-push gate\""],
    "livespec": ["§\"Enforcement-suite invocation\""]
  },
  "template": "livespec",
  "spec_root": "SPECIFICATION",
  "implementation": { "plugin": "livespec-orchestrator-beads-fabro" },
  // Planning/work-item-resolution registry. These targets are the repo slugs
  // accepted by cross-tenant DependsOnEntry refs (`sibling_work_item`,
  // `pull_request`, and `branch`).
  "cross_repo_targets": {
    "livespec": {
      "github_url": "https://github.com/thewoolleyman/livespec",
      "local_clone": "/data/projects/livespec",
      "default_branch": "master"
    },
    "livespec-dev-tooling": {
      "github_url": "https://github.com/thewoolleyman/livespec-dev-tooling",
      "local_clone": "/data/projects/livespec-dev-tooling",
      "default_branch": "master"
    },
    "livespec-orchestrator-beads-fabro": {
      "github_url": "https://github.com/thewoolleyman/livespec-orchestrator-beads-fabro",
      "local_clone": "/data/projects/livespec-orchestrator-beads-fabro",
      "default_branch": "master"
    },
    "livespec-driver-pi": {
      "github_url": "https://github.com/thewoolleyman/livespec-driver-pi",
      "local_clone": "/data/projects/livespec-driver-pi",
      "default_branch": "master"
    }
  },
  // Credential-injection wrapper (fleet default) prefixed to the beads CLIs
  // so a bare invocation self-heals its tenant credential projection.
  "credential_wrapper": ["/usr/local/bin/with-livespec-env.sh", "--"],
  // Harness declarations. NOTE these are deliberately NOT the library-style
  // "exempt" entries livespec-runtime carries: the overseer DOES ship an
  // operator command surface (`overseerd`, `overseer-start`), so claiming
  // exemption on the grounds of "ships no command surface" would be false.
  // The declaration is read twice — the fleet-time `baseline-harnesses` row
  // only checks the object is non-empty, but the per-repo
  // `check-plugin-resolution` Verifier reads the SHAPE, so each entry must
  // carry a real `canonical_command` (supported) or `reason` (exempt).
  "harnesses": {
    "claude": {
      "status": "supported",
      "canonical_command": "livespec-overseer:overseer"
    },
    // The value is the BARE `<plugin>:<skill>` form, byte-identical to the
    // `claude` entry above. That is the fleet convention, not an oversight:
    // `plugin_resolution._command_surface_prompt` adds `/` for claude and adds
    // NOTHING for codex, so the sigil is a harness rendering concern the checker
    // owns rather than part of the stored value. Both fleet repos that ship a
    // working codex surface declare the same string for both harnesses
    // (livespec-orchestrator-beads-fabro, livespec-driver-codex).
    //
    // DO NOT hand-verify this by typing `/livespec-overseer:overseer` into a
    // Codex TUI. Measured twice, ~21h apart: "Unrecognized command". Codex does
    // not use Claude's `/plugin:skill` syntax and the picker's own insertion form
    // is `$`-prefixed. That is a hand-verification hazard, not a declaration
    // hazard, and mistaking it for one reads as "the plugin is not installed"
    // when it is installed.
    //
    // WHAT KEEPS THIS HONEST. The Verifier's codex arm is a
    // DelegatedResolutionRunner that returns available=False -> SKIP, and
    // `_parse_supported` requires only a NON-EMPTY STRING here — so any string
    // passes the fleet gate. The repo-local `check-codex-skill-picker` is the
    // delegate that makes it load-bearing: it drives a live Codex TUI `/skills`
    // picker and requires the row named by THIS value to render, so editing it to
    // anything unbacked goes red (overseer-kju6wh).
    "codex": {
      "status": "supported",
      "canonical_command": "livespec-overseer:overseer"
    }
  },
  // Optional — spec_governance: policy levers for livespec's spec-side
  // operations. The commented defaults below are derived from the shipped
  // spec-governance manifest; leaving this block commented arms nothing, so
  // every operation uses the same safe defaults it would use with no
  // spec_governance block at all.
  // To enable any key, add the block as a real key above (a comma after the
  // `harnesses` block) and keep only the entries this repo intentionally
  // overrides:
  //   "spec_governance": {
  //     // propose_change_mode (enum; allowed: "interactive", "batch")
  //     "propose_change_mode": "interactive",
  //     // critique_mode (enum; allowed: "interactive", "batch")
  //     "critique_mode": "interactive",
  //     // in_flight_alignment (enum; allowed: "prompt", "default-align")
  //     "in_flight_alignment": "prompt",
  //     // doctor_dispositions (map; allowed values: "fix-now",
  //     // "capture-as-work-item", "propose-change", "defer", "dismiss")
  //     "doctor_dispositions": {},
  //     // revise_decision_mode (enum; allowed: "manual", "delegated",
  //     // "consensus"; per-proposal override: decision_policy)
  //     "revise_decision_mode": "manual",
  //     // drift_acceptance_mode (enum; allowed: "human", "consensus")
  //     "drift_acceptance_mode": "human",
  //     // ratification_review (enum; allowed: "manual-spawn", "auto-spawn";
  //     // per-proposal override: ratification_review_policy)
  //     "ratification_review": "manual-spawn",
  //     // ratification_reviewer_model (string; no enumerated allowed values)
  //     "ratification_reviewer_model": null,
  //     // ratification_min_review_age_seconds (integer; minimum: 1)
  //     "ratification_min_review_age_seconds": 1,
  //     // spec_pr_merge (enum; allowed: "manual", "auto-on-green")
  //     "spec_pr_merge": "manual"
  //   }
  //
  "spec_governance": {
    "propose_change_mode": "batch",
    // critique_mode / in_flight_alignment / ratification_review / spec_pr_merge:
    // Increment 1/2 shipped these levers but the fleet-wide rollout never
    // applied them (epic livespec-jvdvx4, child livespec-jvdvx4.15). Non-
    // interactive critique, default-align on in-flight proposals, an
    // auto-spawned independent adversarial review before ratification, and
    // auto-merge-on-green for spec PRs (the auto-spawned review is the
    // safeguard that replaces a human merge click — no code-level carve-out
    // forces ratification-landing PRs to stay manual).
    "critique_mode": "batch",
    "in_flight_alignment": "default-align",
    // Maintainer direction 2026-08-16 first armed this lever as "consensus"
    // so a reviewed proposal would ratify via panel decision instead of
    // waiting on a maintainer prompt — but "consensus" is CURRENTLY INERT:
    // livespec's revise_decision.py resolver (`if mode in {"manual",
    // "consensus"}: ...`) treats consensus identically to manual pending the
    // not-yet-built Increment-3 cross-vendor panel. That is the actual root
    // cause of two sessions (livespec-overseer-foreman,
    // resume-submit-integrity-supervisor) stalling on avoidable manual
    // revise gates later that same day. "delegated" is the mode that
    // actually functions today; revisit this back to "consensus" once
    // Increment 3 ships the panel.
    "revise_decision_mode": "delegated",
    // ratification_review: "auto-spawn" is inert without a configured
    // reviewer model (effective.py's effective_ratification_review returns
    // requires_input=True when ratification_reviewer_model is None).
    // ratification_reviewer_model: an ordered list. Opus is the primary
    // ratification reviewer and auto-spawn selects it; gpt-6-astra (Codex) is the
    // fallback, and a review by EITHER model ratifies. The models are
    // interchangeable like any other model selection here.
    // History: a single designated model originally (2026-08-16); "opus"
    // 2026-08-26 (PR #1973); ["opus", "gpt-6-astra"] 2026-10-26 (R70, livespec
    // core v0.44.0). A migration is not finished when the value flips: keep this
    // comment in lockstep with the value below.
    "ratification_review": "auto-spawn",
    "ratification_reviewer_model": ["opus", "gpt-6-astra"],
    "spec_pr_merge": "auto-on-green",
    // An impl->spec drift finding is dispositioned by the cross-vendor consensus
    // panel rather than parked for a human. Added as the required companion of
    // livespec-overseer.full_autonomy, which the foreman-seat retirement
    // (SPECIFICATION v047) removed along with its only reader; this key is kept
    // on its own merits. check-full-autonomy-config-conformance still guards the
    // pairing for any repo that declares the lever.
    "drift_acceptance_mode": "consensus"
  },
  "livespec-overseer": {
    "compat": {
      "livespec": ">=0.1.0,<1.0.0",
      // Bootstrap placeholder; the first successful cross-repo fan-out
      // rewrites this to a livespec release tag.
      "pinned": "v0.44.0"
    }
  },
  "livespec-orchestrator-beads-fabro": {
    "format": "beads",
    "compat": {
      "livespec": ">=0.1.0,<1.0.0",
      "pinned": "v0.44.0"
    },
    // Per-repo beads tenant CONNECTION block, read by the plugin's
    // commands/_config.py. `tenant` == `database` == `server_user` is the
    // load-bearing tenant-identity rule — all three are this repo's name.
    // `prefix` is a DIFFERENT thing: bd's server-stored issue-ID create-prefix
    // (the plugin's _config.py documents it as exactly that, e.g. `bd-ib`),
    // which `bd rename-prefix` caps at 8 characters — so the full repo name
    // cannot be the prefix here. This tenant's server-stored prefix is
    // `overseer` (set 2026-07-22, when the first real records minted with a
    // scratch-dir-derived junk prefix and were renamed); ids read
    // `overseer-<suffix>`. The value below MUST match the server-stored
    // prefix or the plugin mints/validates against the wrong id shape.
    //
    // TCP-only, NO `socket` key: the dolt unix socket dir is 0750 dolt:dolt and
    // inaccessible to this caller, so the connection must go over 127.0.0.1:3307.
    //
    // The tenant PASSWORD is deliberately ABSENT and never committed. It is the
    // single shared fleet `BEADS_DOLT_PASSWORD`, supplied at bd-call time by the
    // `credential_wrapper` above. Isolation comes from the per-tenant SQL user
    // plus a DB-scoped grant, not from password distinctness — verified
    // 2026-07-20 that this tenant is denied access to livespec-runtime's DB.
    //
    // `fake` is false so the committed config describes the REAL connection; CI
    // sets LIVESPEC_BEADS_FAKE=1 to force the hermetic backend, since GitHub CI
    // cannot reach the localhost dolt-server.
    "connection": {
      "tenant": "livespec-overseer",
      "prefix": "overseer",
      "database": "livespec-overseer",
      "server_user": "livespec-overseer",
      "server_host": "127.0.0.1",
      "server_port": 3307,
      "fake": false
    },
    // Acceptance policy. Set EXPLICITLY to the fleet standard rather than left
    // to the resolver default: `resolve_acceptance_mode` (owned by
    // livespec-orchestrator-beads-fabro, in
    // `.claude-plugin/scripts/livespec_orchestrator_beads_fabro/commands/_dispatcher_policy_settings.py`)
    // defaults to "ai-then-human", so a repo that says nothing silently opts
    // OUT of the fleet standard. Five governed repos had drifted this way —
    // this one plus the adopters homelab, openbrain, and resume, and the
    // not-yet-registered dolt-server — each un-noticed because omission looks
    // identical to agreement. Maintainer-directed 2026-07-29: every governed
    // repo is "ai-only".
    //   acceptance_mode: "ai-only" — post-merge acceptance without a human.
    // Admission policy. `auto_approve_ready` is a DIFFERENT lever from
    // acceptance above: it governs whether a `pending-approval` item is
    // admitted to the ready set without a human, not what happens after a
    // merge. It was previously left unset here — noted at the time as simply
    // out of scope for the 2026-07-29 acceptance direction rather than as a
    // considered opt-out — which meant the resolver default applied and every
    // item in this repo waited at the admission gate for a person. That made
    // livespec-overseer the ONLY governed repo where `pending-approval` was a
    // real human valve, so the fleet-wide guidance "pending-approval is not a
    // human valve" was inverted here and had to be special-cased by anyone
    // dispatching against this tenant.
    //   auto_approve_ready: true — admission without a human.
    // Maintainer-directed 2026-08-11, when the overseer-pfpfty realization
    // chain (overseer-pfpfty.1 through .5) was filed and its head slice sat
    // unstartable behind that gate. This is a REPO-WIDE change: it admits every
    // future item in this tenant, not only that chain. The human controls that
    // remain are unaffected — `blocked-reason:needs-human` items (such as
    // overseer-pfpfty.2, the ratification valve) are still held, and
    // acceptance_mode above still governs post-merge disposition.
    //
    // EDIT THIS BLOCK BY HAND. Do NOT use `drive --action set-config:<k>:<v>`:
    // that surface round-trips the file through json.dumps and silently strips
    // every comment here while reporting green — tracked as bd-ib-lmi5.
    "dispatcher": {
      "fabro_sandbox_image": "ghcr.io/thewoolleyman/livespec-fabro-sandbox:python-agent-v1.92.0",
      "sandbox_capabilities": ["terminal", "headless_browser", "tmux", "herdr"],
      // Dispatch-time toolchain and conformance premises, in the shape the
      // Dispatcher's typed repository integration contract reads
      // (`dispatcher.prepare_toolchain.*`, `dispatcher.conformance.*`).
      //
      // WHY THESE ARE HERE. Until livespec-orchestrator-beads-fabro 39526e5c
      // (2026-08-31 06:15Z, bd-ib-b7xpzl) these five commands were HARDCODED in
      // the implement-work-item prepare chain and ran for every dispatched
      // sandbox in the fleet. That commit turned each into a projection of the
      // governed repository's own declaration, whose fleet default is the
      // ratified explicit NO-OP. A repository that declares nothing therefore no
      // longer trusts and installs its pinned toolchain — so a sandbox
      // `uv sync --all-groups` fails on an UNTRUSTED .mise.toml — no longer
      // installs its hook manager, and no longer installs or verifies the
      // structural commit-refuse hook that fires the Red-Green-Replay gates on
      // every in-sandbox commit. Nothing fails when that happens: the run
      // proceeds and reads green. Only the `conformance.*` trio warns at
      // dispatch time; the two `prepare_toolchain.*` premises go SILENTLY to
      // no-op. Measured here 2026-09-04: every impl dispatch died at sandbox
      // setup on `uv sync` (mise refusing the untrusted .mise.toml) once the
      // exit-127 `{{ inputs.* }}` masking bug (bd-ib-8atx, released v0.124.3 at
      // 15:29Z) was fixed and unmasked this second layer.
      //
      // These declarations restore exactly what this repository's sandboxes ran
      // before 39526e5c, copied verbatim from livespec-orchestrator-beads-
      // fabro's own .livespec.jsonc. `internal_livespec_dev_tooling` renders
      // `uv run python -m livespec_dev_tooling.<module>`; it is valid HERE
      // because livespec-overseer carries the livespec-dev-tooling package as a
      // dev dependency (pyproject.toml), so the `uv sync --all-groups` prepare
      // step immediately before has already put it in the sandbox venv.
      //
      // The fleet-wide fix that makes a fleet member INHERIT these by default
      // (so no consumer silently no-ops again, plus a check that a fleet
      // member's RESOLVED premises are non-empty) is tracked as livespec-
      // orchestrator-beads-fabro bd-ib-i7ag; this explicit declaration is
      // correct now and remains a valid override after that lands.
      //
      // EDIT THIS BLOCK BY HAND — the set-config caveat above applies here too.
      // Per-node ACP turn ceilings (orchestrator contracts.md "ACP node
      // timeouts"). Absent, every node runs at the 1800 s default.
      // MEASURED 2026-09-06, hp run 01M1VWNNBP7QEHRC5J0GVNQKQF
      // (overseer-5ugiuj.1, the foreman-seat code cut): the implement node
      // hit `ACP turn timed out` at 1800033 ms and again at 1800039 ms, then
      // the engine's checkpoint commit died in this repo's 260 s pre-commit
      // aggregate on a half-finished tree (check-coverage,
      // check-per-file-coverage, check-doctor-static red), so 64 minutes of
      // work were lost with no preserved diff. A multi-module cut plus this
      // repo's own `just check` cannot fit one 30-minute turn; these values
      // are the ones the console tenant measured and declared for the same
      // shape (livespec-console-beads-fabro .livespec.jsonc, 2026-09-01).
      //
      // `review_fix` RAISED 3600 -> 14400 and `fix` 3600 -> 7200, MEASURED
      // 2026-10-11 on overseer-sqeifg. review_fix hit `ACP turn timed out` at
      // 3600 s in three consecutive hp runs (01M4M6YP8H3Y55SKPK4CMG6VCG,
      // 01M4MFNJAMDSCZKG13MD9QNDYN twice: 3600810 ms and 3600563 ms), each
      // time still committing, and each time the engine's checkpoint commit
      // then died with `git checkpoint commit failed for node 'review_fix'`.
      // The arithmetic is what the implement ceiling already encodes: one
      // hook-gated commit on that branch runs ~11 minutes, and every accepted
      // finding owes a Red AND a Green commit, so a four-finding round cannot
      // fit one hour. `fix` completed in 2769293 ms (77% of its old ceiling)
      // in the same run. The Dispatcher derives its subprocess ceiling from
      // these values, so no other setting moves with them.
      //
      // LOWERED 2026-10-19 (coordinator ruling R261, maintainer direction to
      // run the factory on the Codex allowance): `fix` 7200 -> 3600 and
      // `review_fix` 14400 -> 7200, matching livespec-orchestrator-beads-fabro.
      // Every node timeout feeds the Codex credential-lifetime floor, and at
      // 7200/14400 that floor was 884100 s, longer than a fresh ten-day Codex
      // token (864000 s), so a Codex-primary node here could never be admitted.
      // The values below bring it to 833700 s. This knowingly gives up part
      // of the 2026-10-11 headroom measured above; the coordinator ruled the
      // risk worth taking over keeping the factory on Claude.
      "node_timeouts": {
        "implement": 14400,
        "janitor": 3600,
        "fix": 3600,
        "review_fix": 7200
      },
      // AMENDED 2026-10-20 (coordinator R273, stability): implement is back on
      // claude-acp / claude-opus-5 / high PRIMARY with codex-acp / gpt-5.6-terra /
      // high as its fallback. Codex-Terra implement failed 3 of 4 runs with one
      // signature, LIVESPEC_IMPLEMENT_PARTIAL_PROGRESS (Red committed, Green amend
      // or the full hook interrupted); it returns to Codex only after the measured
      // root cause is fixed and one clean canary. fix stays on Terra for now.
      //
      // CURRENT factory agent policy (2026-10-20, coordinator ruling R267,
      // maintainer direction to use all available tokens holistically):
      // implement and fix stay codex-acp / gpt-5.6-terra / high with their
      // claude-opus-5 fallback. Every other node is back on its pre-R261 Claude
      // tier with its R261 Codex model as the fallback, so each run draws on
      // both pools: dod_gate, review_fix, proof_capture, proof_verify and review
      // on claude-opus-5 high (Terra high fallback); pr on claude-sonnet-4-6
      // high and disposition on claude-sonnet-4-6 medium (Luna low fallback).
      // The R261 node_timeouts above stay, since implement and fix remain
      // Codex-primary and every node timeout feeds the Codex credential floor.
      //
      // R261 factory agent policy (2026-10-19, coordinator ruling R261,
      // maintainer direction: "switch factory nodes to codex corresponding models
      // and use those available tokens"): every node is Codex-primary, tier for
      // tier, with its previous Claude model kept as the fallback. The seven
      // Opus-tier work nodes run codex-acp / gpt-5.6-terra / high; pr and
      // disposition run codex-acp / gpt-5.6-luna / low. Both models answered a
      // live ACP turn on the factory's Codex (ChatGPT) account that day; the
      // node_timeouts above were lowered so the Codex credential floor fits a
      // fresh token. The paragraph below records the policy this replaced.
      //
      // PREVIOUS factory agent policy: every factory node runs a Claude adapter. The
      // seven work nodes (dod_gate, implement, fix, review_fix, proof_capture,
      // proof_verify, review) run claude-acp / claude-opus-5 at high; the
      // scripted pr route runs claude-sonnet-4-6 at high and disposition at
      // medium -- the form livespec-orchestrator-beads-fabro adopted in its PR
      // 2950. No factory node runs Codex: maintainer direction 2026-10-14
      // (bd-ib-5pxtaw) reserves Codex astra for consensus and reviews OUTSIDE
      // the factory nodes and puts it on no factory node for now. From
      // 2026-10-14 until this change every node here ran codex-acp
      // (gpt-5.6-sol xhigh; pr/disposition gpt-5.6-terra); measured 2026-10-15
      // on run 01M4YS5RSV6Q (overseer-pffwyp), whose dod_gate ran on Codex.
      //
      // These structured entries resolve through the released agent and model
      // catalogs to the baked Claude ACP adapter. The resolver derives mode from
      // node posture: review and disposition are read-only; every other node is
      // agent-full-access. A structured adapter replaces the workflow default's
      // environment completely, so no model or effort variables are inherited.
      // Do not use the retired dispatcher.codex_models shorthand.
      // Codex model prices for the cost report: the published Standard,
      // short-context USD per 1M tokens (developers.openai.com/api/docs/models/,
      // verified 2026-10-19), cache writes at 1.25x input.
      "model_catalog": {
        "anthropic/claude-sonnet-5-5": {
          "display_name": "Claude Sonnet 5.5",
          "pricing": {
            "model": "claude-sonnet-5-5",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 10.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        },
        "openai/gpt-5.6-terra": {
          "display_name": "GPT-5.6 Terra",
          "pricing": {
            "model": "gpt-5.6-terra",
            "input_usd_per_million": 2.0,
            "output_usd_per_million": 12.0,
            "cache_write_usd_per_million": 2.5,
            "cache_read_usd_per_million": 0.2
          }
        },
        "openai/gpt-5.6-luna": {
          "display_name": "GPT-5.6 Luna",
          "pricing": {
            "model": "gpt-5.6-luna",
            "input_usd_per_million": 0.2,
            "output_usd_per_million": 1.2,
            "cache_write_usd_per_million": 0.25,
            "cache_read_usd_per_million": 0.02
          }
        }
      },
      // CODEX-FIRST on every node (maintainer direction 2026-10-25: the factory runs OpenAI
      // models by default with Anthropic minimized; fleet-wide ruling by coordinator
      // gitops-fleet-capacity-monitoring). codex-acp is each node's primary and claude-acp
      // its fallback, used only when Codex hits its limit. Same block as
      // livespec-orchestrator-beads-fabro a03cbeb0. Only gpt-5.6-terra and gpt-5.6-luna,
      // the slugs proven reachable on the factory's ChatGPT account.
      "acp_nodes": {
        "dod_gate": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "implement": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "fix": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "review_fix": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        // 2026-10-26: proof nodes moved luna medium -> terra high, extending the orchestrator move
        // (b5fb6931) after its first terra proof_verify PASS (bd-ib-yzxmuo run 01M5VB0EHEKG), per coordinator ruling.
        "proof_capture": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] },
        "proof_verify": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] },
        "review": { "agent": "codex-acp", "model": "gpt-5.6-terra", "effort": "high", "fallbacks": [{ "agent": "claude-acp", "model": "claude-opus-5", "effort": "high" }] },
        "pr": { "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "low", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] },
        "disposition": { "agent": "codex-acp", "model": "gpt-5.6-luna", "effort": "low", "fallbacks": [{ "agent": "claude-acp", "model": "claude-sonnet-5-5", "effort": "medium" }] }
      },
      "prepare_toolchain": {
        "mise": ["sh", "-c", "mise trust && env -u GITHUB_TOKEN -u GH_TOKEN -u GITHUB_API_TOKEN mise install --quiet"],
        "lefthook": ["uv", "run", "lefthook", "install"]
      },
      "conformance": {
        "hook_install": { "mode": "internal_livespec_dev_tooling" },
        "verify_commit_refuse_hook": { "mode": "internal_livespec_dev_tooling" },
        "verify_plugin_resolution": { "mode": "internal_livespec_dev_tooling" }
      },
      "acceptance_mode": "ai-only",
      "auto_approve_ready": true,
      "wip_cap": 10,
      // Factory table — REGISTRY-BACKED, naming no machine
      // (SPECIFICATION/constraints.md §"Factory routing", ratified v063). Every
      // committed entry declares `"registry": true` and carries no `server` and
      // no `docker_host`. Which Fabro server answers to a factory NAME is bound
      // only in the fleet gitops inventory's factory registry
      // (livespec-dev-tooling §"Fabro factory registry"), which each dispatching
      // host renders as /etc/livespec/fabro-factories.json; a dispatch resolves
      // a registry-backed entry from that file by name.
      //
      // The earlier switch to a registry-backed table changed no routing
      // (coordinator rulings R318 and R320, 2026-10-20, plan
      // petri-factory-on-gmktec, epic bd-ib-fyozyd): the
      // control node's registry maps `legacy` to the same instance the retired
      // `hp` entry named literally. The retired `vps` entry is dropped outright
      // — maintainer instruction 2026-08-22 already forbids routing any of this
      // repository's work there. A recorded per-item `dispatch_factory` pin
      // still naming `hp` or `vps` falls back to `default_factory` under the
      // ratified recorded-pin fallback, so no in-flight item is stranded.
      //
      // `petri` ADDED and made the default (coordinator ruling R668,
      // 2026-10-22, cutover bd-ib-iud52v): the registry maps `petri` to the
      // gmktec-xubuntu :32276 Petri-era instance. Its keys follow the
      // orchestrator's own petri entry: `bin` is the Petri-era carrier fabro
      // client the dispatch runs against this factory, `secret_channel`
      // `native_secrets` delivers credentials through Fabro's native secrets,
      // and `environment` `livespec-ci` supplies the sandbox image on petri,
      // so `fabro_sandbox_image` above is left as it is. `legacy` was
      // retired and removed on 2026-10-24 (plan fabro-currency); a recorded
      // pin naming it, `hp` or `vps` now falls back to `petri`.
      //
      // KNOWN CONSEQUENCE, tracked separately and deliberately NOT fixed here:
      // `overseer/_supervisor_wait_target_liveness.factory_server()` does
      // resolve a registry-backed entry's server by name from the rendered
      // registry file, but the probe then runs the `fabro` on PATH (not the
      // entry's `bin`), and `process_records_from_payload()` accepts only an
      // object carrying `runs` or `items`, while the 0.254 client prints a
      // top-level array. Wait-target liveness therefore still answers
      // `unknown` for `petri` runs.
      "factories": {
        "petri": {
          "registry": true,
          "bin": "/home/ubuntu/.local/state/fabro-currency/carrier-petri-v0.382-adeefec4c/fabro",
          "secret_channel": "native_secrets",
          // factory-python: the toolchain-named catalog id (livespec-dev-tooling
          // SPECIFICATION, "Factory sandbox environment naming"). Its provider, not
          // this id, says where the sandbox runs, so a provider move changes nothing here.
          "environment": "factory-python"
        }
      },
      "default_factory": "petri"
    }
  }
}
